# --- App ---
NODE_ENV=development
PORT=5006
LOG_LEVEL=info
# Daftar origin frontend dipisah koma. "*" hanya boleh untuk development.
CORS_ORIGINS=http://localhost:5173

# --- SQL Server (samakan dengan WPS) ---
# Dipakai akun `sa`. Itu akun admin, bukan user read-only: service ini memang
# hanya membaca data, tetapi `sa` tetap punya izin penuh. Diterima apa adanya.
# Kalau nanti ingin lebih ketat, buat user khusus dengan izin SELECT saja.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Timeout query (ms). Naikkan bila ada SP lambat, mis. SP_LapProduktivitasDashboard ~18 detik.
DB_REQUEST_TIMEOUT_MS=120000

# --- JWT (HARUS SAMA PERSIS dengan JWT_SECRET di WPS backend) ---
JWT_SECRET=change_me_min_8_chars
JWT_ALG=HS256
# Nama field username di payload token WPS. Sudah dicek ke token WPS asli.
JWT_USERNAME_CLAIM=username

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Gotenberg ---
# Di host (bun run dev): port 3100, sesuai port yang dipublish docker-compose.yml.
# Di dalam Docker: http://gotenberg:3000
GOTENBERG_URL=http://localhost:3100
GOTENBERG_TIMEOUT_MS=60000

# --- Worker & file ---
REPORT_CONCURRENCY=2
STORAGE_DIR=storage
# File PDF lebih tua dari ini dihapus oleh worker.
FILE_RETENTION_DAYS=7
# Seberapa sering worker menyapu file kedaluwarsa. 168 jam = 7 hari.
FILE_CLEANUP_INTERVAL_HOURS=168
